{
  "name": "hongbing-site",
  "version": "1.0.0",
  "private": true,
  "description": "Hong Bing Sim — personal site: a scroll journey through one cloud of fragments, plus the Hackathon Crash Course.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run agent-docs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "agent-docs": "tsx scripts/generate-agent-docs.ts",
    "fragments": "tsx scripts/generate-fragments.ts",
    "fragments:check": "tsx scripts/generate-fragments.ts --check",
    "verify:entrance": "node scripts/verify-cold-start.mjs",
    "verify:cursor": "node scripts/cursor-checks.mjs",
    "shots:walk": "node scripts/walk-shots.mjs",
    "check:walk": "tsx scripts/render-walk-checks.ts",
    "readme:art": "node scripts/generate-readme-art.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toorcn/hong-bing-site.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/toorcn/hong-bing-site/issues"
  },
  "homepage": "https://hong.build",
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "its-fine": "^2.0.0",
    "lenis": "^1.3.26",
    "next": "^16.3.0",
    "next-mdx-remote": "^6.0.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/mdx": "^16.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "gray-matter": "^4.0.3",
    "puppeteer": "^25.5.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=22"
  }
}
